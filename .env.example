# ===== 应用 =====
FINRAG_APP_NAME=FinRAG
FINRAG_DEBUG=false
FINRAG_API_PREFIX=/api/v1
FINRAG_SECRET_KEY=change-me-in-production
FINRAG_CORS_ORIGINS=["*"]

# ===== 数据库（业务元数据） =====
# 示例：mysql+pymysql://finrag:finrag@localhost:3306/finrag
# SQLite（本地开发）: sqlite:///./finrag.db
FINRAG_DB_URL=sqlite:///./finrag.db

# ===== 业务数据源（智能问数查询的真实业务库；留空则回退 db_url） =====
# 示例：mysql+pymysql://readonly:ro@localhost:3306/analytics
FINRAG_BUSINESS_DB_URL=

# ===== Redis（任务队列 / 缓存） =====
FINRAG_REDIS_URL=redis://localhost:6379/0

# ===== Qdrant 向量库 =====
FINRAG_QDRANT_HOST=localhost
FINRAG_QDRANT_PORT=6333
FINRAG_QDRANT_COLLECTION=finrag_docs
FINRAG_VECTOR_SIZE=1024

# ===== LLM 网关（双模式：cloud / local / auto） =====
FINRAG_LLM_MODE=auto
FINRAG_LLM_TIMEOUT=120
FINRAG_LLM_MAX_RETRIES=2
# 云端（OpenAI 兼容协议，如 DeepSeek / 通义 / OpenAI）
FINRAG_LLM_CLOUD_BASE_URL=https://api.deepseek.com/v1
FINRAG_LLM_CLOUD_API_KEY=
FINRAG_LLM_CLOUD_MODEL=deepseek-chat
# 本地（Ollama / vLLM）
FINRAG_LLM_LOCAL_BASE_URL=http://localhost:11434/v1
FINRAG_LLM_LOCAL_MODEL=qwen2.5:7b

# ===== Embedding（双模式：local / api） =====
# provider: local(bge-m3) / api(OpenAI 兼容，如 硅基流动/OpenAI/通义)
FINRAG_EMBEDDING_PROVIDER=local
FINRAG_EMBEDDING_MODEL=BAAI/bge-m3
FINRAG_EMBEDDING_API_BASE_URL=
FINRAG_EMBEDDING_API_KEY=
# 云端模型名；留空则复用 EMBEDDING_MODEL
FINRAG_EMBEDDING_API_MODEL=

# ===== Rerank（双模式：local / api） =====
FINRAG_RERANK_ENABLED=true
# provider: local(bge cross-encoder) / api(云端 rerank 端点)
FINRAG_RERANK_PROVIDER=local
FINRAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
FINRAG_RERANK_API_BASE_URL=
FINRAG_RERANK_API_KEY=
# 云端模型名；留空则复用 RERANK_MODEL
FINRAG_RERANK_API_MODEL=
# API 格式：cohere(扁平 /rerank，Jina/硅基流动/Cohere/阿里 qwen3-rerank) | dashscope(嵌套 input/parameters，阿里 gte-rerank-v2/qwen3-vl-rerank)
FINRAG_RERANK_API_FORMAT=cohere

# ===== 混合检索 =====
FINRAG_RRF_K=60
FINRAG_RETRIEVE_TOP_K=20
FINRAG_RERANK_TOP_K=5

# ===== 切分 =====
FINRAG_CHUNK_SIZE=512
FINRAG_CHUNK_OVERLAP=64

# ===== SQL 安全校验（智能问数） =====
FINRAG_SQL_MAX_ROWS=100
FINRAG_SQL_ALLOWED_TABLES=["product_sales","customer_account","transaction_record"]
FINRAG_SQL_SENSITIVE_COLUMNS=["mobile","id_card","email"]

# ===== MCP 执行器（智能问数执行层） =====
# mcp_enabled=true 且配置 SERVER_URL 时走外部 DB MCP Server（streamable-http），
# 连接失败自动降级为直连业务库（FINRAG_BUSINESS_DB_URL）；
# 工具按 list_tables/get_schema/execute_sql 语义自动发现映射（execute_sql/read_query/query/sql 等）。
FINRAG_MCP_ENABLED=false
FINRAG_MCP_SERVER_COMMAND=
FINRAG_MCP_SERVER_URL=
FINRAG_MCP_API_KEY=
FINRAG_MCP_TIMEOUT=30

# ===== Celery =====
FINRAG_CELERY_BROKER_URL=redis://localhost:6379/0
FINRAG_CELERY_RESULT_BACKEND=redis://localhost:6379/1
